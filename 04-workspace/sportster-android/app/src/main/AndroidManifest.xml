<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sportster"
        android:windowSoftInputMode="adjustResize">

        <!-- Splash -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Sportster.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding -->
        <activity
            android:name=".ui.auth.OnboardingActivity"
            android:exported="false"
            android:noHistory="true" />

        <!-- Auth -->
        <activity android:name=".ui.auth.LoginActivity"    android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.OtpActivity"      android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.auth.ForgotPasswordActivity" android:exported="false" />

        <!-- Main -->
        <activity android:name=".ui.home.MainActivity" android:exported="false" />

        <!-- Profile -->
        <activity android:name=".ui.profile.EditProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize"/>
        <activity android:name=".ui.profile.SettingsActivity" android:exported="false" />

        <!-- Arena Booking -->
        <activity android:name=".ui.arenas.ArenaBookingActivity"    android:exported="false" />
        <activity android:name=".ui.arenas.ArenaDetailActivity"     android:exported="false" />
        <activity android:name=".ui.arenas.ArenaSlotPickerActivity" android:exported="false" />
        <activity android:name=".ui.arenas.BookingConfirmedActivity" android:exported="false" />

        <!-- Gym Booking -->
        <activity android:name=".ui.gym.GymListActivity"              android:exported="false" />
        <activity android:name=".ui.gym.GymDetailActivity"            android:exported="false" />
        <activity android:name=".ui.gym.GymMachinesActivity"          android:exported="false" />
        <activity android:name=".ui.gym.GymSlotPickerActivity"        android:exported="false" />
        <activity android:name=".ui.gym.GymBookingConfirmedActivity"  android:exported="false" />

        <!-- Tournaments -->
        <activity android:name=".ui.events.TournamentListActivity"   android:exported="false" />
        <activity android:name=".ui.events.TournamentDetailActivity" android:exported="false" />

    </application>

</manifest>
