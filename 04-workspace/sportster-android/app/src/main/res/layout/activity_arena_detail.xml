<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero Image Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash_gradient" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏟️"
                android:textSize="64sp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="16dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@drawable/bg_circle_surface2"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/surface">

            <TextView
                android:id="@+id/tvArenaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arena Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvArenaSport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sport · Location"
                android:textSize="14sp"
                android:textColor="@color/text2"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="★ 4.8  (128 reviews)"
                    android:textSize="13sp"
                    android:textColor="@color/gold" />

                <TextView
                    android:id="@+id/tvArenaPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs 2,000/hr"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amenities -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="8dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amenities"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🅿️ Parking"
                    android:textSize="13sp"
                    android:textColor="@color/text2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚿 Showers"
                    android:textSize="13sp"
                    android:textColor="@color/text2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💡 Floodlights"
                    android:textSize="13sp"
                    android:textColor="@color/text2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🥤 Café"
                    android:textSize="13sp"
                    android:textColor="@color/text2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📡 Scoreboard"
                    android:textSize="13sp"
                    android:textColor="@color/text2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👕 Changing Room"
                    android:textSize="11sp"
                    android:textColor="@color/text2" />
            </LinearLayout>
        </LinearLayout>

        <!-- CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBookNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="Book Now"
            style="@style/Widget.Sportster.Button.Primary" />

    </LinearLayout>
</ScrollView>
