<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="🏋️"
            android:textSize="48sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_green_light"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gym Session Booked!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/gym"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get ready to crush it! 💪 Your session is confirmed."
            android:textSize="14sp"
            android:textColor="@color/text2"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Gym Pass Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/gym"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvBookingId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gym Pass #GP12345"
                    android:textSize="12sp"
                    android:textColor="#CCffffff"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvGymName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gym Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time: 6:00 AM · 1 hr"
                    android:textSize="14sp"
                    android:textColor="#CCffffff"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs 500/hr"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to Home"
            style="@style/Widget.Sportster.Button.Primary" />

    </LinearLayout>
</ScrollView>
